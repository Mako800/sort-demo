{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport { ref } from 'vue';\nexport default {\n  __name: 'App',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const inputStr = ref('');\n    const steps = ref([]);\n    const errorMsg = ref('');\n    const handleClick = async () => {\n      steps.value = [];\n      errorMsg.value = '';\n      const parts = inputStr.value.trim().split(/\\s+/);\n      const nums = parts.map(Number).filter(x => !isNaN(x));\n      if (nums.length === 0) {\n        errorMsg.value = '请输入至少一个有效整数';\n        return;\n      }\n      try {\n        const response = await fetch('http://localhost:8080/sort', {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json'\n          },\n          body: JSON.stringify(nums)\n        });\n        if (!response.ok) throw new Error('请求失败');\n        steps.value = await response.json();\n      } catch (err) {\n        errorMsg.value = '排序出错：' + err.message;\n      }\n    };\n    const __returned__ = {\n      inputStr,\n      steps,\n      errorMsg,\n      handleClick,\n      ref\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","inputStr","steps","errorMsg","handleClick","value","parts","trim","split","nums","map","Number","filter","x","isNaN","length","response","fetch","method","headers","body","JSON","stringify","ok","Error","json","err","message"],"sources":["E:/Coding/web/sort/frontend/src/App.vue"],"sourcesContent":["<template>\n  <div id=\"mainBody\">\n    <input id=\"input\" v-model=\"inputStr\" @keyup.enter=\"handleClick\" placeholder=\"输入若干整数，用空格分隔\" />\n    <button @click=\"handleClick\">排序</button>\n\n    <div v-if=\"steps.length > 0\" class=\"steps-container\">\n      <p>归并排序过程：</p>\n      <div v-for=\"(step, index) in steps\" :key=\"index\" class=\"step\">\n        <span class=\"step-index\">第 {{ index + 1 }} 步：</span>\n        <span>{{ step.join(' ') }}</span>\n        </br>\n      </div>\n    </div>\n\n    <p v-if=\"errorMsg\" style=\"color:red\">{{ errorMsg }}</p>\n  </div>\n</template>\n\n<script setup>\nimport { ref } from 'vue'\n\nconst inputStr = ref('')\nconst steps = ref([])\nconst errorMsg = ref('')\n\nconst handleClick = async () => {\n  steps.value = []\n  errorMsg.value = ''\n\n  const parts = inputStr.value.trim().split(/\\s+/)\n  const nums = parts.map(Number).filter(x => !isNaN(x))\n\n  if (nums.length === 0) {\n    errorMsg.value = '请输入至少一个有效整数'\n    return\n  }\n\n  try {\n    const response = await fetch('http://localhost:8080/sort', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify(nums)\n    })\n    if (!response.ok) throw new Error('请求失败')\n    steps.value = await response.json()\n  } catch (err) {\n    errorMsg.value = '排序出错：' + err.message\n  }\n}\n</script>\n\n<style scoped>\n#mainBody {\n  text-align: center;\n  margin-top: 50px;\n}\n\n.steps-container {\n  margin-top: 24px;\n}\n\n.step {\n  margin: 8px 0;\n  font-size: 16px;\n  background: #f8f9fa;\n  padding: 6px 12px;\n  border-radius: 4px;\n  display: inline-block;\n}\n\n.step-index {\n  font-weight: bold;\n  margin-right: 10px;\n  color: #42b883;\n}\n</style>"],"mappings":";;;AAmBA,SAASA,GAAG,QAAQ,KAAI;;;;;;;IAExB,MAAMC,QAAQ,GAAGD,GAAG,CAAC,EAAE;IACvB,MAAME,KAAK,GAAGF,GAAG,CAAC,EAAE;IACpB,MAAMG,QAAQ,GAAGH,GAAG,CAAC,EAAE;IAEvB,MAAMI,WAAW,GAAG,MAAAA,CAAA,KAAY;MAC9BF,KAAK,CAACG,KAAK,GAAG,EAAC;MACfF,QAAQ,CAACE,KAAK,GAAG,EAAC;MAElB,MAAMC,KAAK,GAAGL,QAAQ,CAACI,KAAK,CAACE,IAAI,CAAC,CAAC,CAACC,KAAK,CAAC,KAAK;MAC/C,MAAMC,IAAI,GAAGH,KAAK,CAACI,GAAG,CAACC,MAAM,CAAC,CAACC,MAAM,CAACC,CAAC,IAAI,CAACC,KAAK,CAACD,CAAC,CAAC;MAEpD,IAAIJ,IAAI,CAACM,MAAM,KAAK,CAAC,EAAE;QACrBZ,QAAQ,CAACE,KAAK,GAAG,aAAY;QAC7B